[Desktop Entry]
Type=Application
Name=Omaview
GenericName=Image Viewer
Comment=Dead-simple, theme-aware image viewer for Omarchy
Exec=omaview %U
Icon=omaview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/x-icon;
Keywords=image;viewer;picture;photo;graphics;
StartupWMClass=omaview
